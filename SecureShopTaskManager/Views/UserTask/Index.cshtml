@model IEnumerable<SecureShopTaskManager.Models.UserTask>

@{
    ViewData["Title"] = "Tasks";
}

<div class="container mt-4">

    <h2 class="text-primary mb-4">Task List</h2>

    <table class="table table-bordered table-hover shadow">

        <thead class="table-dark">

            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Status</th>
                <th>Action</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.Title</td>

                    <td>@item.Description</td>

                    <td>
                        @if (item.IsCompleted)
                        {
                            <span class="badge bg-success">
                                Completed
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>
                        }
                    </td>

                    <td>

                        @if (User.HasClaim("CanEditTask", "true"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-primary btn-sm">
                                Edit
                            </a>
                        }

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>